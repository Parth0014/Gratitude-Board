MODE="production"

# Gratitude Studio does not use Excalidraw-hosted storage, collaboration,
# library, AI, Firebase, Plus, or tracking services. External asset providers
# are exposed only through this application's own /api routes.
VITE_APP_ENABLE_TRACKING=false
VITE_APP_DEBUG_ENABLE_TEXT_CONTAINER_BOUNDING_BOX=false
VITE_APP_COLLAPSE_OVERLAY=false
VITE_APP_ENABLE_ESLINT=false
