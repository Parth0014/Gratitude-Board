# 2026-09-26 21:49:22.163531
+/add apps\web\src\components\& {
+    $QwenBin  = "$env:USERPROFILE\bin"
+    $AiderBin = "$env:USERPROFILE\.local\bin"
+
+    # Verify qwen.cmd exists
+    $QwenCmd = Join-Path $QwenBin "qwen.cmd"
+
+    if (-not (Test-Path $QwenCmd)) {
+        throw "qwen.cmd not found at $QwenCmd"
+    }
+
+    Write-Host "Found qwen.cmd at:" -ForegroundColor Green
+    Write-Host $QwenCmd
+
+    # Fix current terminal immediately
+    $env:Path = "$QwenBin;$AiderBin;$env:Path"
+
+    # Fix future terminals permanently
+    $UserPath = [Environment]::GetEnvironmentVariable("Path", "User")
+
+    $Parts = @(
+        $UserPath -split ";" |
+        Where-Object { $_ -and $_.Trim() }
+    )
+
+    foreach ($p in @($QwenBin, $AiderBin)) {
+        if ($Parts -notcontains $p) {
+            $Parts += $p
+        }
+    }
+
+    $NewUserPath = ($Parts | Select-Object -Unique) -join ";"
+
+    [Environment]::SetEnvironmentVariable(
+        "Path",
+        $NewUserPath,
+        "User"
+    )
+
+    Write-Host ""
+    Write-Host "Testing..." -ForegroundColor Cya   Get    Write-Host ""    Write-Host "PATH FIXED." -ForegroundColor Gr    Write-Host "You can now run:"    Write-Host "    qwen" -ForegroundColor Cyan}

